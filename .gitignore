node_modules
.next/
dist/

# Environment secrets — NEVER commit real credentials
.env
.env.local
.env.staging
.env.production
.env.*.local
!.env.example
!.env.staging.example

# Local upload storage (real client files — never commit)
apps/api/uploads/

# Terraform local cache/providers — never commit
infra/aws/.terraform/
*.tfstate
*.tfstate.*

# Real Playwright evidence artifacts — only the BINARY captures (screenshots/
# traces/videos) are local-only, matching the established uploads/ and
# .terraform/ precedent (may incidentally capture real client-adjacent UI
# state even from disposable QA fixtures). The structured .md/.html evidence
# REPORTS are deliberately tracked — they contain no binary/visual capture,
# only text observations, and are the durable, reviewable record.
test-evidence/**/*.png
test-evidence/**/*.mp4
test-evidence/**/*.webm
test-evidence/**/*.zip
test-evidence/**/trace/
