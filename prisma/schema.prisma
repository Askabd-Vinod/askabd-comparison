generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model migrations {
  name       String   @id @db.VarChar(255)
  applied_at DateTime @default(now()) @db.Timestamptz(6)

  @@map("_migrations")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model brand {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String   @db.VarChar(255)
  slug         String   @unique @db.VarChar(255)
  logo_url     String?
  description  String?
  website      String?
  verified     Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  manufacturer String?  @db.VarChar(255)
  aliases      String[] @default([])
  social_links Json?    @default("{}")
  categories   String[] @default([]) @db.Uuid
  status       String?  @default("active") @db.VarChar(30)
  media        Json?    @default("[]")
  metadata     Json?    @default("{}")
  item         item[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model campaign {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  merchant_id  String?   @db.Uuid
  tenant_id    String    @default("public") @db.VarChar(255)
  name         String    @db.VarChar(255)
  type         String    @db.VarChar(30)
  status       String    @default("draft") @db.VarChar(30)
  starts_at    DateTime? @db.Timestamptz(6)
  ends_at      DateTime? @db.Timestamptz(6)
  config       Json      @default("{}")
  item_ids     String[]  @default([]) @db.Uuid
  category_ids String[]  @default([]) @db.Uuid
  metadata     Json?     @default("{}")
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  merchant     merchant? @relation(fields: [merchant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([merchant_id], map: "idx_campaign_merchant")
  @@index([status, starts_at], map: "idx_campaign_status")
}

model category {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id           String                @default("public") @db.VarChar(255)
  name                String                @db.VarChar(255)
  slug                String                @db.VarChar(255)
  parent_id           String?               @db.Uuid
  icon                String?               @db.VarChar(100)
  description         String?
  comparison_template Json?                 @default("[]") @map("comparison_template")
  sort_order          Int?                  @default(0)
  active              Boolean               @default(true)
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  category            category?             @relation("categoryTocategory", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  other_category      category[]            @relation("categoryTocategory")
  comparison          comparison[]
  templates           comparison_template[]
  item                item[]
  merchant_category   merchant_category[]
  price_rule          price_rule[]
  search_history      search_history[]

  @@unique([tenant_id, slug])
  @@index([parent_id], map: "idx_cat_parent")
  @@index([tenant_id, active], map: "idx_cat_tenant")
}

model comparison {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenant_id   String    @default("public") @db.VarChar(255)
  user_id     String    @db.Uuid
  title       String?   @db.VarChar(500)
  category_id String?   @db.Uuid
  item_ids    String[]  @default([]) @db.Uuid
  notes       String?
  is_public   Boolean   @default(false)
  share_token String?   @db.VarChar(100)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @default(now()) @db.Timestamptz(6)
  category    category? @relation(fields: [category_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([share_token], map: "idx_comparison_share")
  @@index([user_id], map: "idx_comparison_user")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model comparison_attribute {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id         String              @db.Uuid
  name                String              @db.VarChar(255)
  slug                String              @db.VarChar(255)
  data_type           String              @default("text") @db.VarChar(30)
  unit                String?             @db.VarChar(50)
  options             Json?               @default("[]")
  is_comparable       Boolean             @default(true)
  is_filterable       Boolean             @default(false)
  is_required         Boolean             @default(false)
  display_order       Int?                @default(0)
  group_name          String?             @db.VarChar(100)
  weight              Decimal?            @default(1.0) @db.Decimal(3, 2)
  comparison_template comparison_template @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([template_id, display_order], map: "idx_attr_template")
}

model comparison_template {
  id                   String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  category_id          String                 @db.Uuid
  name                 String                 @db.VarChar(255)
  slug                 String                 @db.VarChar(255)
  attribute_groups     Json                   @default("[]")
  layout_config        Json?                  @default("{}")
  version              Int                    @default(1)
  created_at           DateTime               @default(now()) @db.Timestamptz(6)
  comparison_attribute comparison_attribute[]
  category             category               @relation(fields: [category_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([category_id], map: "idx_template_category")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  item_id             String              @db.Uuid
  variant_id          String?             @db.Uuid
  merchant_id         String              @db.Uuid
  warehouse           String?             @default("default") @db.VarChar(255)
  location            String?             @db.VarChar(255)
  quantity            Int                 @default(0)
  reserved            Int                 @default(0)
  low_stock_threshold Int?                @default(5)
  status              String              @default("in_stock") @db.VarChar(30)
  updated_at          DateTime            @default(now()) @db.Timestamptz(6)
  item                item                @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  merchant            merchant            @relation(fields: [merchant_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  item_variant        item_variant?       @relation(fields: [variant_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  inventory_history   inventory_history[]

  @@unique([item_id, variant_id, merchant_id, warehouse])
  @@index([item_id], map: "idx_inventory_item")
  @@index([merchant_id, status], map: "idx_inventory_merchant")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model inventory_history {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  inventory_id    String    @db.Uuid
  change_type     String    @db.VarChar(30)
  quantity_change Int
  quantity_after  Int
  reason          String?
  actor_id        String?   @db.Uuid
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  inventory       inventory @relation(fields: [inventory_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([inventory_id, created_at(sort: Desc)], map: "idx_inv_history")
}

