  @@index([user_id, searched_at(sort: Desc)], map: "idx_search_user")
}

model wishlist_item {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id               String   @db.Uuid
  item_id               String   @db.Uuid
  notes                 String?
  price_alert_threshold BigInt?
  created_at            DateTime @default(now()) @db.Timestamptz(6)
  item                  item     @relation(fields: [item_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([user_id, item_id])
  @@index([user_id], map: "idx_wishlist_user")
}
