{
  "name": "askabd-comparison",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "dev:all": "node scripts/dev-all.mjs",
    "health": "node scripts/health.mjs",
    "playwright:setup-staff": "npm exec -w apps/api -- tsx --env-file=.env scripts/setup-playwright-test-staff.ts",
    "playwright:smoke": "node scripts/playwright-evidence/authenticated-smoke-test-1.mjs",
    "validate:e2e": "npm run playwright:setup-staff && npm run playwright:smoke",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "playwright": "1.62.1",
    "prisma": "^7.9.1"
  }
}
