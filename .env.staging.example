# AskABD Staging Environment Configuration
# Copy to .env.staging and fill with REAL staging values.
# NEVER commit .env.staging with real secrets to version control.

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=4200
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=<STAGING_DATABASE_URL>
# Example: postgresql://askabd_app:<password>@staging-db.region.rds.amazonaws.com:5432/askabd?sslmode=require

# ─── Security ───────────────────────────────────────────────────────────────
JWT_SECRET=<STAGING_JWT_SECRET>
# Generate: openssl rand -base64 48
CORS_ORIGIN=<STAGING_WEB_DOMAIN>
# Example: https://staging.askabd.com

# ─── Email ──────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=smtp
SMTP_HOST=<STAGING_SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<STAGING_SMTP_USERNAME>
SMTP_PASS=<STAGING_SMTP_PASSWORD>

# ─── Storage ────────────────────────────────────────────────────────────────
STORAGE_PROVIDER=s3
S3_BUCKET=<STAGING_S3_BUCKET>
S3_REGION=<STAGING_AWS_REGION>
DOCUMENT_STORAGE_PATH=

# ─── Web Application ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=<STAGING_API_URL>
# Example: https://api-staging.askabd.com
API_PUBLIC_URL=<STAGING_API_URL>

# ─── Jira (optional) ────────────────────────────────────────────────────────
# Configure via UI at /platform/integrations/jira instead

# ─── Scheduler ──────────────────────────────────────────────────────────────
SCHEDULER_AUTH_TOKEN=<STAGING_SCHEDULER_TOKEN>
