# AskABD Platform — Environment Configuration Template
# Copy to .env and fill in actual values.
# NEVER commit .env with real credentials.

# ─── Application ────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4200
HOST=0.0.0.0
LOG_LEVEL=info

# ─── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://askabd_user:CHANGE_ME@localhost:5432/askabd
POSTGRES_DB=askabd
POSTGRES_USER=askabd_user
POSTGRES_PASSWORD=CHANGE_ME

# ─── Security ───────────────────────────────────────────────────────────────
# Choose exactly ONE verification mode:
#
# JWKS_URL — the real path when verifying tokens from the actual askabd-identity
# service. askabd-identity signs EVERY token with EdDSA (see
# askabd-identity/src/services/token-service.ts) and publishes its public key(s) at
# JWKS_URL below — JWT_SECRET (HS256) can NEVER verify a real askabd-identity token,
# regardless of what value it's set to, because the algorithms are fundamentally
# incompatible. Leave JWT_SECRET unset when using JWKS_URL.
JWKS_URL=http://localhost:4300/.well-known/jwks.json
# JWT_ISSUER/JWT_AUDIENCE must match what askabd-identity actually issues (its real,
# hardcoded issuer is 'askabd-identity'; its configurable TOKEN_AUDIENCE defaults to
# 'askabd-platform' — see askabd-identity/src/config/env.ts). JWT_AUDIENCE is only
# enforced when set.
JWT_ISSUER=askabd-identity
JWT_AUDIENCE=askabd-platform
#
# JWT_SECRET (HS256) — only relevant if this API is verifying tokens from a
# different, symmetric-key issuer of your own, NOT the real askabd-identity service.
# JWT_SECRET=CHANGE_ME_TO_A_SECURE_RANDOM_STRING_MIN_32_CHARS
CORS_ORIGIN=https://app.askabd.com

# ─── Email ──────────────────────────────────────────────────────────────────
# Provider: mailpit (DEV only), smtp, ses
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# AWS SES (production)
# SES_REGION=us-east-1
# SES_DOMAIN=askabd.com

# ─── Storage ────────────────────────────────────────────────────────────────
# Provider: local (DEV), s3 (production)
STORAGE_PROVIDER=local
DOCUMENT_STORAGE_PATH=./uploads
# AWS S3 (production)
# S3_BUCKET=askabd-documents-production
# S3_REGION=us-east-1

# ─── Web Application ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://api.askabd.com
API_PUBLIC_URL=https://api.askabd.com

# ─── Scheduler ──────────────────────────────────────────────────────────────
# External cron should call POST /api/v1/oc/scheduler/run-all
# with proper authentication token.
SCHEDULER_AUTH_TOKEN=CHANGE_ME

# ─── Backup ─────────────────────────────────────────────────────────────────
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE=local
# For S3: BACKUP_S3_BUCKET=askabd-backups
# For R2: BACKUP_R2_BUCKET=askabd-backups
